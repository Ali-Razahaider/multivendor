# Copy to backend/config/.env for local development. Never commit real values.

PORT=8000
NODE_ENV=development
MONGO_DB_URI=mongodb://localhost:27017/bazaarly
# At least 32 random characters in production: `openssl rand -hex 32`
JWT_SECRET=change-me

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=pk_test_xxx          # publishable key (sent to the browser)
STRIPE_SECRET_KEY=sk_test_xxx       # secret key (server only)
# From `stripe listen --forward-to localhost:8000/api/payment/webhook` or the dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Transactional email (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Bazaarly

# Image uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Business rules (optional)
SHIPPING_RATE=0.1               # 10% of each shop's subtotal
FREE_SHIPPING_THRESHOLD=0       # e.g. 100 for free shipping over $100 per shop; 0 disables
PLATFORM_FEE_RATE=0.1           # share of each delivered order kept by the platform

# Cookies (optional) — see backend/utils/cookies.js
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
